// prisma/schema.prisma - SQLite Compatible Version
generator client {
  provider = "prisma-client-js"
}



// ========== USER & AUTH MODELS ==========

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  password  String?  // For credentials auth
  role      Role     @default(ADMIN)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  photos          Photo[]
  events          Event[]
  historicalPosts HistoricalPost[]
  
  // NextAuth relations
  accounts Account[]
  sessions Session[]

  @@index([email])
  @@index([role])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ========== CONTENT MODELS ==========

model Category {
  id          String   @id @default(cuid())
  name        String
  nameEn      String?
  slug        String   @unique
  description String?
  order       Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  photos Photo[]

  @@index([slug])
  @@index([isActive])
  @@index([order])
}

model Photo {
  id            String   @id @default(cuid())
  title         String
  titleEn       String?
  description   String?
  descriptionEn String?
  filename      String
  url           String
  thumbnailUrl  String?
  alt           String
  order         Int      @default(0)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Foreign keys
  categoryId String
  userId     String

  // Relations
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  uploadedBy User     @relation(fields: [userId], references: [id])

  @@index([categoryId])
  @@index([userId])
  @@index([isActive])
  @@index([createdAt])
  @@index([order])
}

model Event {
  id            String        @id @default(cuid())
  title         String
  titleEn       String?
  description   String?
  descriptionEn String?
  eventDate     DateTime
  endDate       DateTime?
  location      String?
  isActive      Boolean       @default(true)
  isPinned      Boolean       @default(false)
  category      EventCategory @default(ANNOUNCEMENT)
  imageUrl      String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  
  // Foreign key
  createdBy String

  // Relations
  creator User @relation(fields: [createdBy], references: [id], onDelete: Cascade)

  @@map("events")
  @@index([eventDate])
  @@index([isActive])
  @@index([isPinned])
  @@index([category])
  @@index([createdBy])
}

// ========== FIXED: HISTORICAL POST MODEL ==========
model HistoricalPost {
  id        String   @id @default(cuid())
  title     String
  slug      String   @unique
  excerpt   String
  content   String   // FIXED: Removed @db.Text (not supported in SQLite)
  images    Json     // FIXED: Changed from String[] to Json (SQLite compatible)
  isActive  Boolean  @default(true)
  isPinned  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  // Foreign key
  creatorId String

  // Relations
  creator User @relation(fields: [creatorId], references: [id], onDelete: Cascade)

  @@map("historical_posts")
  @@index([slug])
  @@index([isActive])
  @@index([isPinned])
  @@index([createdAt])
  @@index([creatorId])
}

// ========== ANALYTICS MODELS ==========

model PageView {
  id         String   @id @default(cuid())
  path       String
  userAgent  String?
  country    String?
  referrer   String?
  sessionId  String
  userId     String?
  timestamp  DateTime @default(now())
  timeOnPage Int?     // in seconds

  @@map("page_views")
  @@index([path])
  @@index([sessionId])
  @@index([timestamp])
  @@index([userId])
}

model AnalyticsSession {
  id         String    @id @default(cuid())
  sessionId  String    @unique
  userId     String?
  startTime  DateTime  @default(now())
  endTime    DateTime?
  totalPages Int       @default(1)
  bounced    Boolean   @default(true)
  country    String?
  device     String?
  browser    String?

  @@map("analytics_sessions")
  @@index([startTime])
  @@index([userId])
}

model ContentAnalytics {
  id           String   @id @default(cuid())
  contentType  String   // 'photo', 'event', 'page', 'historical_post'
  contentId    String
  path         String
  views        Int      @default(0)
  uniqueViews  Int      @default(0)
  avgTimeSpent Int      @default(0) // in seconds
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([contentType, contentId])
  @@map("content_analytics")
  @@index([contentType])
  @@index([path])
}

// ========== ENUMS ==========

enum Role {
  ADMIN
  EDITOR
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")        // pooled for app traffic
  directUrl = env("DIRECT_DATABASE_URL")// direct for migrate
}

enum EventCategory {
  ANNOUNCEMENT
  FESTIVAL
  MEETING
  CULTURAL
  RELIGIOUS
  SPORTS
  COMMUNITY
  OTHER
}
