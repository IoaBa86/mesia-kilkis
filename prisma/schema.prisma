generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_DATABASE_URL")
}

model User {
  id              String           @id @default(cuid())
  email           String           @unique
  name            String?
  password        String?
  role            Role             @default(ADMIN)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  accounts        Account[]
  photos          Photo[]
  sessions        Session[]
  events          Event[]
  historicalPosts HistoricalPost[]

  @@index([email])
  @@index([role])
}

model CookieConsent {
  id           String   @id @default(cuid())
  ipAddress    String
  ipHash       String?
  consentGiven Boolean
  categories   Json
  userAgent    String?
  timestamp    DateTime @default(now())

  @@map("cookie_consents")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Category {
  id          String   @id @default(cuid())
  name        String
  nameEn      String?
  slug        String   @unique
  description String?
  order       Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  photos      Photo[]

  @@index([slug])
  @@index([isActive])
  @@index([order])
}

model Photo {
  id            String   @id @default(cuid())
  title         String
  titleEn       String?
  description   String?
  descriptionEn String?
  filename      String
  url           String
  thumbnailUrl  String?
  alt           String
  order         Int      @default(0)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  categoryId    String
  userId        String
  category      Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  uploadedBy    User     @relation(fields: [userId], references: [id])

  // Original indexes
  @@index([categoryId])
  @@index([userId])
  @@index([isActive])
  @@index([createdAt])
  @@index([order])

  // 🚀 NEW: Performance indexes for photos page
  @@index([isActive, categoryId])
  @@index([isActive, createdAt])
  @@index([categoryId, order])
}

model Event {
  id            String        @id @default(cuid())
  title         String
  titleEn       String?
  description   String?
  descriptionEn String?
  eventDate     DateTime
  endDate       DateTime?
  location      String?
  isActive      Boolean       @default(true)
  isPinned      Boolean       @default(false)
  category      EventCategory @default(ANNOUNCEMENT)
  imageUrl      String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  createdBy     String
  creator       User          @relation(fields: [createdBy], references: [id], onDelete: Cascade)

  // Original indexes
  @@index([eventDate])
  @@index([isActive])
  @@index([isPinned])
  @@index([category])
  @@index([createdBy])

  // 🚀 NEW: Performance indexes for events page
  @@index([isActive, eventDate])
  @@index([isPinned, eventDate])
  @@index([isActive, category])
  @@index([isActive, isPinned, eventDate])
  @@index([category, eventDate])

  @@map("events")
}

model HistoricalPost {
  id        String   @id @default(cuid())
  title     String
  slug      String   @unique
  excerpt   String
  content   String
  images    Json
  isActive  Boolean  @default(true)
  isPinned  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  creatorId String
  creator   User     @relation(fields: [creatorId], references: [id], onDelete: Cascade)

  @@index([slug])
  @@index([isActive])
  @@index([isPinned])
  @@index([createdAt])
  @@index([creatorId])

  @@map("historical_posts")
}

model SiteConfig {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
  updatedBy String?

  @@map("site_config")
}

model AdSlot {
  id        String   @id @default(cuid())
  key       String   @unique
  name      String
  page      String
  position  String
  adClient  String
  adSlotId  String
  adFormat  String   @default("auto")
  isActive  Boolean  @default(true)
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([page])
  @@index([isActive])
  @@map("ad_slots")
}

enum Role {
  ADMIN
  EDITOR
}

enum EventCategory {
  ANNOUNCEMENT
  FESTIVAL
  MEETING
  CULTURAL
  RELIGIOUS
  SPORTS
  COMMUNITY
  OTHER
}
