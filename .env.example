# Database (Neon/Postgres, or any Postgres instance — e.g. one added in Coolify) — see prisma/schema.prisma
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require&channel_binding=require"
DIRECT_DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require&channel_binding=require"

# NextAuth — generate a secret with: openssl rand -base64 32
NEXTAUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"

# Admin login (src/lib/auth.ts) — must match a real ADMIN user's email
ADMIN_EMAIL=""

# Only used by scripts/create-admin.js and scripts/fix-admin-password.js
# (one-off local scripts to create/reset the admin account). Not read by
# the app itself. Never commit a real value.
ADMIN_PASSWORD=""

# Google Maps JavaScript API key — used on /access (Πώς να Έρθετε).
# Without this the map falls back to a "directions on Google Maps" link.
# Setup: https://console.cloud.google.com — enable "Maps JavaScript API",
# enable billing, create a key, restrict it to your domain(s).
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=""

# Email (SMTP) — configured at runtime via /admin/settings, not env vars.
# NEXTAUTH_URL above is also used to build the invite-email login link.
